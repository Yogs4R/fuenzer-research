# Backend Environment Variables
# Copy this file as .env and fill in your values.
# NEVER commit the actual .env file.

GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here
PORT=8080
ENV=development
ALLOWED_ORIGINS=http://localhost:5173,https://research.fuenzer.web.id

# SMTP Configuration (for custom HTML emails)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key_here
SMTP_FROM=Fuenzer Research <noreply@yourdomain.com>

# Firebase API Key (Get this from Firebase Console or frontend .env VITE_FIREBASE_API_KEY)
FIREBASE_API_KEY=your_firebase_api_key_here



