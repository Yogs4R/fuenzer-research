rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow users to read and write only their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /history/{sessionId} {
        // Owner can always read/write their own sessions
        // Any authenticated user can read a session if it is explicitly marked public
        allow read: if request.auth != null && (
          request.auth.uid == userId ||
          resource.data.isPublic == true
        );
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /bookmarks/{sourceId} {
        // Allow users to read and write only their own bookmarked sources
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /libraries/{libraryId} {
        // Owner can always read/write their own libraries
        // Any authenticated user can read a library document if isPublic == true
        allow read: if request.auth != null && (
          request.auth.uid == userId ||
          resource.data.isPublic == true
        );
        allow write: if request.auth != null && request.auth.uid == userId;

        match /bookmarks/{sourceId} {
          // Anyone who can read the parent library can also read its bookmarks
          allow read: if request.auth != null && (
            request.auth.uid == userId ||
            get(/databases/$(database)/documents/users/$(userId)/libraries/$(libraryId)).data.isPublic == true
          );
          // Only the owner can write bookmarks
          allow write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
  }
}

